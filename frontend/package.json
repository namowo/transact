{
  "name": "frontend",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/lucide": "^1.2.135",
    "@nuxt/ui": "^2.20.0",
    "@openvue/themes": "1.1.1",
    "@primeicons/vue": "^8.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.18.1",
    "openvue": "^1.0.0",
    "pinia": "^4.0.2",
    "primeicons": "^8.0.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.29",
    "vue-router": "^4.6.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^3.1.4",
    "@vue/eslint-config-typescript": "^14.0.1",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.73.0",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^8.0.3",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.3",
    "vite": "^6.2.7",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vitest": "^3.1.4",
    "vue-tsc": "^3.0.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "vue-demi@0.14.10": true,
    "fsevents": false
  }
}
